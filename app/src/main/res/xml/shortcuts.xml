            android:targetClass="com.monsivamon.golender.MainActivity">
            <extra
                android:name="com.monsivamon.golender.EXTRA_SHORTCUT_ACTION"
                android:value="today" />
        </intent>
    </shortcut>

    <shortcut
        android:shortcutId="shortcut_search"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_search"
        android:shortcutShortLabel="@string/shortcut_search_short"
        android:shortcutLongLabel="@string/shortcut_search_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.monsivamon.golender"
