<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- カレンダー読み取り権限 -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- カレンダー書き込み権限 -->
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- 通知表示権限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 正確なアラーム設定権限 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- バッテリー最適化除外要求権限 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 起動完了通知の受信権限 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- ネットワーク通信権限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 高精度位置情報権限 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- おおよその位置情報権限 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- アプリ全体の定義（Applicationクラス・テーマ・バックアップ規則） -->
    <application
        android:name=".GolenderApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <!-- メイン画面（ランチャー起動・ショートカット定義） -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MyApplication"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- 通知を表示するレシーバ -->
        <receiver
            android:name=".notification.NotificationReceiver"
            android:exported="false" />

        <!-- 起動完了・アプリ更新時に通知を再登録するレシーバ -->
        <receiver
            android:name=".notification.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 1日の予定ウィジェット -->
        <receiver
            android:name=".widget.DayWidgetReceiver"
            android:label="1日の予定"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/day_widget_info" />
        </receiver>

        <!-- 週間カレンダーウィジェット -->
        <receiver
            android:name=".widget.WeekWidgetReceiver"
            android:label="週間カレンダー"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/week_widget_info" />
        </receiver>

        <!-- 月間カレンダーウィジェット -->
        <receiver
            android:name=".widget.MonthWidgetReceiver"
            android:label="月間カレンダー"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/month_widget_info" />
        </receiver>

        <!-- 添付写真を他アプリへ共有するFileProvider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

    <!-- 他アプリ連携用のクエリ（地図アプリ・テキスト共有） -->
    <queries>
        <!-- geo: スキームの地図アプリ解決用 -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <!-- テキスト共有先アプリ解決用 -->
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

</manifest>