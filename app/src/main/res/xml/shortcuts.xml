<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">

    <shortcut
        android:shortcutId="shortcut_add_event"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_add"
        android:shortcutShortLabel="@string/shortcut_add_event_short"
        android:shortcutLongLabel="@string/shortcut_add_event_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.monsivamon.golender"
            android:targetClass="com.monsivamon.golender.MainActivity">
            <extra
                android:name="com.monsivamon.golender.EXTRA_SHORTCUT_ACTION"
                android:value="add_event" />
        </intent>
        <categories android:name="android.shortcut.conversation" />
    </shortcut>

    <shortcut
        android:shortcutId="shortcut_today"
        android:enabled="true"
